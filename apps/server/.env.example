JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
PORT=3000

# Turso (producción). Si ambas están presentes se usa libSQL/Turso.
# Si están vacías se usa SQLite local en data/localgym.sqlite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Ollama (proxy SSE). El backend expone /api/ollama/chat como text/event-stream
# y reenvía los streams de Ollama. Nunca expongas el puerto de Ollama al frontend.
#
# Para Ollama local (sin auth) basta con OLLAMA_BASE_URL apuntando al daemon.
# Para Ollama Cloud hay que definir OLLAMA_API_KEY: el backend enviará
# `Authorization: Bearer <key>` en cada request upstream.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
# API key para Ollama Cloud. Vacía = Ollama local sin auth.
OLLAMA_API_KEY=
# Timeout (ms) del request upstream hacia Ollama. 0 = sin timeout.
OLLAMA_UPSTREAM_TIMEOUT_MS=0
